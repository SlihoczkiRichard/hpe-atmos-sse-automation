# ==============================================================================
# Target Workload & Endpoints
# ==============================================================================
TARGET_APP_URL=https://sr-target-web-szinvanet.axisapps.io/
BACKEND_HOST=10.0.1.123
TCP_TARGET_PORT=443

# ==============================================================================
# Pillar 1: Load Tests (hey, k6, iperf3, telemetry)
# ==============================================================================
# Shared run identifier for all tools of one measurement run (letters, digits, . _ -)
RUN_ID=
# HTTP success = these status codes only (also used by k6 instead of its 200-399 default)
SUCCESS_STATUSES=200
# Acceptance: every run of a level must have primary error rate strictly below this value
ACCEPT_MAX_ERROR_RATE=0.01
# E1 capacity run: 6 levels x 3 sweeps x 60 s (about 20 min); see docs/measurement-guide.md
# E1 capacity profile (range-finding runs E1-20261106-T1 and -T2: throughput peaks at c=1400, about
# 4000 1/s, collapses above it, >1 % errors from c=4000): ramp-up, peak, collapse and failing range
LOAD_CONCURRENCY_STEPS=400,1000,1400,1600,2000,4000
LOAD_STEP_DURATION=60s
LOAD_SWEEPS=3
LOAD_COOLDOWN_SEC=5
LOAD_RATE_LIMIT_QPS=0
LOAD_PERCENTILES=50,75,90,95,99
# true: follow redirects and judge the final response; false: a 3xx counts as non-success
LOAD_FOLLOW_REDIRECTS=true
# k6 verifies TLS unless this is set to true explicitly
K6_INSECURE_SKIP_TLS=false
# Existing directory for k6_<RUN_ID>_summary.json (k6 does not create it)
K6_RESULTS_DIR=01-load-test/results

# Telemetry (collect_connector_telemetry.sh on each connector VM): seconds of start lag / early end
# tolerated before the host's data is marked partial (not a complete time series)
COVERAGE_TOLERANCE_SEC=5

# iperf3 paths: the labels are configuration only; they do not prove the traffic path
IPERF3_DIRECT_HOST=
IPERF3_SSE_HOST=
IPERF3_PARALLEL=8
IPERF3_DURATION_SEC=30
IPERF3_REPETITIONS=3

# Optional menu (lab.py; docs/measurement-guide.md, "Menu-driven runs"). Empty = default.
# Directory on the connector VM, relative to the SSH user's home (telemetry script and data)
LAB_REMOTE_DIR=sse-lab
# Idle seconds between the telemetry start and the load start
LAB_LEAD_SEC=60
# Telemetry length in seconds; empty = computed from the hey plan (1800 for the E1 plan)
LAB_TELEMETRY_SEC=
# Folder on your computer used in the printed copy command (PowerShell syntax)
LAB_COPY_DEST=

# ==============================================================================
# Pillar 2: Autoscaling Telemetry & VMware ESXi Lifecycle Control
# ==============================================================================
# Secrets (passwords, API key) are read from the environment only, never from CLI arguments.
# SSH host keys must be in ~/.ssh/known_hosts or SSH_KNOWN_HOSTS (lab override: --lab-insecure-ssh).

# Primary Connector Guest SSH (ibm09esxi) - CPU Telemetry
CONNECTOR_1_IP=10.0.1.121
CONNECTOR_SSH_USER=your_ssh_user
CONNECTOR_SSH_PASSWORD=your_guest_ssh_password

# Secondary Connector Guest SSH - CPU telemetry (scale-in), guest reachability, connection check
CONNECTOR_2_IP=10.0.1.122
# Optional; default to the CONNECTOR_SSH_* values
CONNECTOR_2_SSH_USER=
CONNECTOR_2_SSH_PASSWORD=

# How the scaler powers on SR-CONN02 (E2):
#   esxi-ssh     vim-cmd over SSH on the ESXi host (needs host-level SSH and an ESXi account; ESXI_* below)
#   vcenter-api  vCenter REST API with a least-privilege user (VCENTER_* below); recommended on a shared host
#   manual       the operator presses Power On when prompted; C2 state = TCP connect to CONNECTOR_2_IP
C2_POWER_BACKEND=esxi-ssh

# vCenter backend: a role with only "Virtual machine > Interaction > Power on / Power off", assigned on
# the SR-CONN02 VM alone (propagation off). The user then cannot see or touch any other VM.
VCENTER_HOST=10.0.1.6
VCENTER_USER=sse-scaler@vsphere.local
VCENTER_PASSWORD=
VCENTER_VM_NAME=SR-CONN02
# Root CA of the vCenter certificate (https://<vcenter>/certs/download.zip); empty = system trust store
VCENTER_CA_BUNDLE=
# auto | api (vSphere 7.0+) | rest (6.5/6.7)
VCENTER_API=auto
# manual backend: guest TCP port used as the power-state proxy
MANUAL_STATE_PORT=22

# Secondary Connector Hypervisor (ibm06esxi) - esxi-ssh backend only
ESXI_HOST=ibm06esxi.szinva.net
ESXI_USER=root
ESXI_PASSWORD=your_esxi_root_password
CONNECTOR_2_VMID=12

# E2 load profile for lab.py e2 (a methodology decision; empty = E2 cannot be started from lab.py).
# Unset E2_* keys fall back to the run_hey_stepped.py defaults (3 sweeps, 30s, cooldown 5, qps 0).
E2_CONCURRENCY_STEPS=
E2_SWEEPS=1
E2_STEP_DURATION=60s
E2_COOLDOWN_SEC=0
E2_RATE_LIMIT_QPS=0
# Seconds the scaler keeps running after the load (scale-out / readiness observation)
E2_OBSERVE_AFTER_SEC=120
SSH_KNOWN_HOSTS=

# Thresholds & Windows
CPU_SCALE_OUT_THRESHOLD=80.0
CPU_SCALE_IN_THRESHOLD=30.0
TRIGGER_WINDOW_SEC=15.0
POLL_INTERVAL_SEC=5.0
CPU_SAMPLE_SEC=1.0

# Scale-in is disabled by default; it then requires valid CPU samples from both connectors
ENABLE_SCALE_IN=false
# Minimum time between power commands, measured from the last dispatched power.on/power.shutdown
# (replaces the deprecated SCALE_IN_COOLDOWN_SEC, which is still read with a warning if this is unset)
SCALER_COOLDOWN_SEC=60.0
# Minimum C2 uptime before scale-in, measured from the first observed "Powered on"
MIN_C2_UPTIME_SEC=300.0

# Power-state polling and activation milestone tracking
POWER_ON_TIMEOUT_SEC=60.0
POWER_STATE_POLL_SEC=1.0
SHUTDOWN_TIMEOUT_SEC=120.0
READINESS_TIMEOUT_SEC=600.0

# Application reachability (not attributed to a connector); TLS is verified by default
HTTP_TIMEOUT_SEC=5.0
APP_EXPECTED_STATUS=200
HTTP_CA_BUNDLE=

# Connector status via Admin API (GET /Connectors/{id}/status; control-plane report only)
ATMOS_CONNECTOR_2_ID=
# Optional; only read by 00-preflight/preflight_check.py
ATMOS_CONNECTOR_1_ID=
CONNECTOR_READY_STATUSES=Available
API_STATUS_SKEW_SEC=0

# Optional C2 connection check: none | ss-established -> C2_MATCHING_CONNECTION_OBSERVED
# (an established C2->BACKEND_HOST:BACKEND_PORT connection; NOT validated as application traffic)
C2_CONNECTION_CHECK=none
BACKEND_PORT=443

# ==============================================================================
# Pillar 3: Failover availability probes (03-failover/failover_probe.py)
# ==============================================================================
# The fault is injected by hand; record it with: failover_probe.py mark --kind fault_injected
# TCP probe: a new connection per probe (name resolution + connect)
FAILOVER_TCP_HOST=
FAILOVER_TCP_PORT=443
FAILOVER_TCP_TIMEOUT_MS=250
# HTTP probe: dedicated static endpoint with a unique token; success = status AND content
FAILOVER_HTTP_URL=
FAILOVER_HTTP_EXPECT_STATUS=200
FAILOVER_HTTP_EXPECT_BODY=
FAILOVER_HTTP_EXPECT_REGEX=
FAILOVER_HTTP_MAX_BODY_BYTES=4096
FAILOVER_HTTP_TIMEOUT_MS=1000
# Target intervals (not a guaranteed resolution)
FAILOVER_INTERVAL_MS=50
FAILOVER_PERSISTENT_INTERVAL_MS=200
FAILOVER_DURATION_SEC=180
# Evaluation: N consecutive successes = stable recovery; baseline before the fault marker
FAILOVER_RECOVERY_N=10
FAILOVER_BASELINE_SEC=30
FAILOVER_BASELINE_MAX_FAILURES=0
FAILOVER_BASELINE_MAX_GAP_MS=1000

# ==============================================================================
# Pillar 4: HPE Aruba SSE Cloud Management REST API
# ==============================================================================
ATMOS_BASE_URL=https://admin-api.axissecurity.com/api/v1.0
ATMOS_API_KEY=your_atmos_jwt_token
ATMOS_API_TIMEOUT_SEC=15
ATMOS_PAGE_SIZE=100

# Sync mode (04-threat-intel/sync_threat_intel.py); apply/restore need an explicit --commit none|after-update
# The managed-by key is a project naming/ownership convention, not an API permission
THREAT_CATEGORY_NAME=URLhaus_Malware_Blocklist
THREAT_CATEGORY_KEY=urlhaus-sync
THREAT_MAX_HOSTS=25
# Optional, e.g. online; empty = no url_status filter
THREAT_URL_STATUS_FILTER=
# Optional file with hosts to exclude (one per line); not a general over-blocking protection
THREAT_EXCLUDE_FILE=

# Canary experiment (04-threat-intel/canary_block_test.py): own, harmless hosts only
# The test category must already exist and be assigned BY HAND to a blocking SWG rule
CANARY_URL=
CANARY_TOKEN=
CANARY_EXPECT_STATUS=200
CANARY_CATEGORY_ID=
CANARY_CATEGORY_NAME=
CANARY_INTERVAL_MS=500
CANARY_HTTP_TIMEOUT_MS=2000
CANARY_MAX_BODY_BYTES=65536
CANARY_BASELINE_SEC=30
CANARY_BASELINE_MAX_WAIT_SEC=120
CANARY_MAX_GAP_MS=1500
CANARY_STABLE_N=10
CANARY_MAX_WAIT_SEC=600
CANARY_RESTORE_MAX_WAIT_SEC=600
# Block signature (validated on the reference host with validate-signature); a pattern is required
SWG_REFERENCE_URL=
SWG_BLOCK_STATUS=
SWG_BLOCK_BODY_REGEX=
SWG_BLOCK_LOCATION_REGEX=
SWG_SIGNATURE_PROBES=5